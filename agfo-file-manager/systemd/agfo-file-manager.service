[Unit]
Description=AGFO File Manager - root dosya yoneticisi (on panel)
Documentation=file:@INSTALL_DIR@/README.md
After=network-online.target agfo-file-manager-backend.service
Wants=network-online.target
Requires=agfo-file-manager-backend.service

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
ExecStart=@PYBIN@ @INSTALL_DIR@/app/server.py
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agfo-file-manager

[Install]
WantedBy=multi-user.target
