[Unit]
Description=AGFO Firewall AI - CrowdSec yonetim paneli
Documentation=file:@INSTALL_DIR@/README.md
After=network-online.target crowdsec.service
Wants=network-online.target

[Service]
Type=simple
# Panel cscli'yi calistirir ve kural uygular: root gerekir.
User=root
Group=root
WorkingDirectory=@INSTALL_DIR@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=LANG=C.UTF-8
Environment=LC_ALL=C.UTF-8
Environment=HOME=/root
ExecStart=@PYBIN@ @INSTALL_DIR@/app/server.py
Restart=always
RestartSec=3
KillMode=mixed
TimeoutStopSec=15
LimitNOFILE=8192
StandardOutput=journal
StandardError=journal
SyslogIdentifier=agfo-firewall-ai

[Install]
WantedBy=multi-user.target
