{
  "bind": "0.0.0.0",
  "port": 8824,
  "public_url": "https://alanadi.com:8824/",
  "tls": {
    "enabled": true,
    "cert": "/etc/letsencrypt/live/alanadi.com/fullchain.pem",
    "key": "/etc/letsencrypt/live/alanadi.com/privkey.pem"
  },
  "auth": {
    "password_hash": "(install.sh uretir)",
    "session_ttl": 43200,
    "login_token": "(install.sh uretir)",
    "token_login": true
  },
  "allow_ips": [],
  "frame_ancestors": [],
  "cookie_samesite": "Strict",
  "cyberpanel": {
    "cli": "",
    "default_owner": "admin",
    "default_package": "Default",
    "default_php": "8.2",
    "issue_ssl": true
  },
  "limits": {
    "max_concurrent_jobs": 2,
    "job_log_lines": 4000,
    "download_timeout": 900
  },
  "network": {
    "allow_downloads": true
  }
}
