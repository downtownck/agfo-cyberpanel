{
  "id": "moodle",
  "name": "Moodle",
  "badge": "MD",
  "category": "learning",
  "tagline": "Açık kaynak öğrenme yönetim sistemi (LMS)",
  "description": "Kurs, sınav ve sertifika yönetimi. Kurulum komut satırından otomatik yapılır; veri dizini site kökünün dışına, /home/<alanadı>/moodledata altına açılır.",
  "homepage": "https://moodle.org",
  "license": "GPL-3.0",
  "install_mode": "cli",
  "tags": [
    "lms",
    "eğitim",
    "kurs"
  ],
  "requires": {
    "php": "8.1",
    "extensions": [
      "mysqli",
      "gd",
      "intl",
      "zip",
      "xml"
    ]
  },
  "download": {
    "url": "https://download.moodle.org/download.php/direct/stable405/moodle-latest-405.tgz",
    "format": "tar.gz",
    "strip": 1
  },
  "fields": [
    {
      "id": "admin_user",
      "label": "Yönetici kullanıcı adı",
      "type": "text",
      "default": "admin"
    },
    {
      "id": "admin_pass",
      "label": "Yönetici şifresi (boş bırakılırsa üretilir)",
      "type": "password",
      "required": false
    },
    {
      "id": "admin_email",
      "label": "Yönetici e-postası",
      "type": "email"
    },
    {
      "id": "site_name",
      "label": "Site adı",
      "type": "text",
      "default": "Moodle"
    }
  ],
  "steps": [
    {
      "mkdir": {
        "path": "{site_home}/moodledata",
        "mode": "0770",
        "base": "home"
      }
    },
    {
      "run": {
        "argv": [
          "{php_bin}",
          "{docroot}/admin/cli/install.php",
          "--non-interactive",
          "--agree-license",
          "--lang=tr",
          "--wwwroot={url}",
          "--dataroot={site_home}/moodledata",
          "--dbtype=mysqli",
          "--dbhost={db_host}",
          "--dbname={db_name}",
          "--dbuser={db_user}",
          "--dbpass={db_pass}",
          "--fullname={site_name}",
          "--shortname={site_name}",
          "--adminuser={admin_user}",
          "--adminpass={admin_pass}",
          "--adminemail={admin_email}"
        ],
        "timeout": 1800
      }
    }
  ],
  "finish": {
    "path": "/login/",
    "note": "İlk girişte Moodle bazı ayarları tamamlamanızı isteyebilir."
  },
  "database": true
}